# Variables de entorno de InvoiceChecker.
# Copia este archivo a .env.local para desarrollo local; en Vercel configúralas
# en Project > Settings > Environment Variables (Production y Preview).
# Nunca uses el prefijo público de Next.js con estas variables: quedarían
# dentro del código que se descarga en el navegador.

# Contraseña compartida de acceso (mínimo 12 caracteres aleatorios).
APP_PASSWORD=

# Secreto para firmar la cookie de sesión (al menos 32 bytes aleatorios).
# Se genera con: openssl rand -base64 48
SESSION_SECRET=

# Solo en Vercel (no en .env.local): pnpm 11 no está en la lista oficial de
# Vercel, así que se activa Corepack para que instale con la versión fijada en
# package.json. Configúrala en el panel de Vercel con valor 1:
# ENABLE_EXPERIMENTAL_COREPACK=1

# Cambiar APP_PASSWORD o SESSION_SECRET cierra la sesión de todas las personas.
